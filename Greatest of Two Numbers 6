import java.io.*;
import java.util.*;


public class CompareNumbers {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Read input
        int a = sc.nextInt();
        int b = sc.nextInt();

        // Compare and print
        if (a > b) {
            System.out.println(a+" is greater");
        } else if (b > a) {
            System.out.println(b+" is greater");
        } else {
            System.out.println("Both are equal");
        }

        sc.close();
    }
}

 
